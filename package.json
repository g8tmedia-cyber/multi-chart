{
  "name": "multi-chart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node dist-server/index.mjs",
    "package:godaddy": "npm run build && python3 scripts/package-godaddy.py"
  },
  "dependencies": {
    "@mathieuc/tradingview": "4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "lucide-react": "0.454.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sirv": "^3.0.2",
    "typescript": "~5.7.2",
    "vite": "^6.4.2"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "main": "dist-server/index.mjs"
}
